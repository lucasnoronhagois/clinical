# URL base da API consumida pelo front (sem /api no final).
# Padrão: /mock-api, a API interna de demonstração (Mock Service Worker) com o mesmo
# contrato da API Node e dados fictícios. Para usar a API real, troque pela URL dela:
#   VITE_API_URL=http://localhost:3000
VITE_API_URL=/mock-api

# Latência simulada da API interna, em milissegundos (só vale com /mock-api).
VITE_MOCK_LATENCY_MS=350
