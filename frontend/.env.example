# URL base da API consumida pelo front (sem /api no final).
# Padrão: /mock-api, a API interna de demonstração (Mock Service Worker) com o mesmo
# contrato da API Node e dados fictícios. Para usar a API real, troque pela URL dela:
#   VITE_API_URL=http://localhost:3000
VITE_API_URL=/mock-api

# Latência simulada da API interna, em milissegundos (só vale com /mock-api).
VITE_MOCK_LATENCY_MS=350

# Tempo, em milissegundos, em que os dados em cache são considerados atualizados.
# Enquanto esse prazo não vence, voltar à tela não dispara uma nova requisição.
# Padrão: 60000 (60 segundos). Valores inválidos voltam ao padrão.
VITE_CACHE_STALE_TIME_MS=60000

# Tempo, em milissegundos, que os dados ficam na memória depois que a tela é deixada (gcTime).
# Padrão: 300000 (5 minutos). Valores inválidos voltam ao padrão.
VITE_CACHE_GC_TIME_MS=300000
