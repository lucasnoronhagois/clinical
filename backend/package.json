{
  "name": "clinicalcare-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do ClinicalCare: gestão de clínicas, pacientes e atendimentos (Node.js, Express, TypeScript, Sequelize).",
  "author": "Lucas Noronha Gois <lucas.noronha.gois@gmail.com>",
  "license": "MIT",
  "keywords": [
    "clinic",
    "healthcare",
    "api",
    "express",
    "sequelize",
    "typescript",
    "jwt"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run migration:run && node dist/server.js",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "tsx src/seeders/seed.ts",
    "seed:reset": "tsx src/seeders/seed.ts --reset",
    "seed:prod": "node dist/seeders/seed.js",
    "db:setup": "npm run migration:run && npm run seed",
    "migration:generate": "sequelize-cli migration:generate --name",
    "migration:run": "sequelize-cli db:migrate",
    "migration:undo": "sequelize-cli db:migrate:undo",
    "migration:undo:all": "sequelize-cli db:migrate:undo:all"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.2",
    "sequelize": "^6.37.7",
    "yup": "^1.7.0",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^29.5.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.2"
  }
}
