# ClinicalCare API: variáveis de ambiente
# Copie para .env e ajuste conforme o seu ambiente.

NODE_ENV=development
PORT=3000

# Segredo usado para assinar os tokens JWT. Gere um valor longo e aleatório em produção:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS, separadas por vírgula. Vazio libera qualquer origem (apenas desenvolvimento).
CORS_ORIGIN=http://localhost:5173

# Banco de dados: mysql (padrão, também funciona com MariaDB) ou sqlite (desenvolvimento rápido, sem servidor)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinicalcare
DB_USER=clinicalcare
DB_PASS=clinicalcare
DB_LOGGING=false

# Somente para DB_DIALECT=sqlite
# DB_STORAGE=./clinicalcare.sqlite
